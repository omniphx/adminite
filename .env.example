# ============================================
# Required: Salesforce Connected App Credentials
# ============================================
# These credentials are required for OAuth authentication with Salesforce.
# Follow the setup instructions in README.md to create a Connected App.
#
# After creating your Connected App, copy this file to `.env` and replace
# the placeholder values with your actual Consumer Key and Consumer Secret.

ELECTRON_WEBPACK_APP_SALESFORCE_CLIENT_ID=your_consumer_key_here
ELECTRON_WEBPACK_APP_SALESFORCE_CLIENT_SECRET=your_consumer_secret_here

# ============================================
# Optional: Development Configuration
# ============================================
# The following variables are automatically configured by the build tools
# and typically don't need to be set manually.

# NODE_ENV=development
# ELECTRON_WEBPACK_WDS_PORT=9080

# ============================================
# Optional: macOS Release Configuration
# ============================================
# Only required when building and notarizing macOS releases using
# `yarn release:mac` or `yarn release`. Not needed for local development.
#
# Use an app-specific password generated from your Apple ID account:
# https://support.apple.com/en-us/HT204397

# APPLEID=your_apple_id@example.com
# APPLEIDPASS=your_app_specific_password
